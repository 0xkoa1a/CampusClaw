ARG PYTHON_IMAGE=python:3.12-slim
FROM ${PYTHON_IMAGE} AS builder
WORKDIR /build
RUN python -m venv /opt/venv \
    && /opt/venv/bin/python -m pip install --no-cache-dir --upgrade 'pip==26.3'
COPY requirements.txt ./requirements.txt
RUN /opt/venv/bin/python -m pip install --no-cache-dir -r requirements.txt
COPY app ./app
COPY scripts ./scripts
COPY apitest ./apitest
COPY wsgi.py ./wsgi.py
RUN /opt/venv/bin/python -m compileall -b -q app scripts apitest wsgi.py \
    && find app scripts apitest -type f -name '*.py' -delete \
    && find scripts apitest -type f ! -name '*.pyc' -delete \
    && rm wsgi.py \
    && python - <<'PY'
from pathlib import Path

# apitest loads each case by its original .py path; leave only generated bytecode loaders.
for bytecode in Path("apitest/cases").rglob("*.pyc"):
    source_path = bytecode.with_suffix("")
    source_path.write_text(
        "import importlib.machinery as _machinery, sys as _sys\n"
        "_machinery.SourcelessFileLoader(__name__, __file__ + 'c').exec_module(_sys.modules[__name__])\n",
        encoding="utf-8",
    )
PY
RUN /opt/venv/bin/python -m pip uninstall -y pip setuptools wheel

FROM ${PYTHON_IMAGE} AS runtime
ARG VCS_REF=unknown
LABEL org.opencontainers.image.revision="${VCS_REF}"
ENV PATH="/opt/venv/bin:${PATH}" \
    PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /build/app ./app
COPY --from=builder /build/scripts ./scripts
COPY --from=builder /build/apitest ./apitest
COPY --from=builder /build/wsgi.pyc ./wsgi.pyc
COPY app/static/vendor/swagger/LICENSE ./LICENSE
RUN rm -rf /usr/local/lib/python3.12/ensurepip /usr/local/lib/python3.12/site-packages/pip* \
    /usr/local/bin/pip /usr/local/bin/pip3 /usr/local/bin/pip3.12 \
    && mkdir -p /app/data /app/uploads && chown -R 10001:10001 /app
USER 10001
EXPOSE 8080
CMD ["gunicorn", "--bind", "0.0.0.0:8080", "--workers", "1", "--worker-class", "gthread", "--threads", "4", "--timeout", "120", "wsgi:app"]
