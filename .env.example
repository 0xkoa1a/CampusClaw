# Fill these with new private values. Never commit .env.
SECRET_KEY=
SEED_TEACHER_PASSWORD=
SEED_STUDENT_A_PASSWORD=
SEED_STUDENT_B_PASSWORD=
MAX_UPLOAD_BYTES=1048576
# Docker Hub unavailable: public.ecr.aws/docker/library/python:3.12-slim
PYTHON_IMAGE=python:3.12-slim
# Copy these from your own course gateway account. Keep the real .env private.
EMBEDDING_BASE_URL=https://ai-gateway.devops.hello1023.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=course-embedding
EMBEDDING_DIM=2048
CHAT_MODEL=course-chat
QDRANT_IMAGE=ghcr.io/qdrant/qdrant/qdrant:v1.19.1
